{
  "name": "labhub",
  "description": "GitLab, but it looks and feels like GitHub, and never shows you stale status.",
  "version": "0.1.2",
  "license": "MIT",
  "author": "Shravan Revanna <shravanrevanna@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myselfshravan/LabHub.git"
  },
  "homepage": "https://github.com/myselfshravan/LabHub#readme",
  "bugs": {
    "url": "https://github.com/myselfshravan/LabHub/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
